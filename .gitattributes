# Automatically detect text files and normalize line endings
* text=auto

# Keep source/config/documentation files consistently LF
*.py      text eol=lf
*.js      text eol=lf
*.jsx     text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf

*.json    text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.toml    text eol=lf
*.md      text eol=lf
*.txt     text eol=lf
*.sh      text eol=lf

# Binary files
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary

*.pdf     binary

*.zip     binary
*.gz      binary
*.tar     binary
